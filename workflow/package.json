{
  "name": "xgif-local-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.js start",
    "start": "node dev.js start",
    "stop": "node dev.js stop",
    "restart": "node dev.js restart",
    "status": "node dev.js status",
    "start:publisher": "node --disable-warning=ExperimentalWarning server.js",
    "data:status": "node --disable-warning=ExperimentalWarning storage-cli.js status",
    "data:rebuild": "node --disable-warning=ExperimentalWarning storage-cli.js rebuild",
    "data:backup": "node --disable-warning=ExperimentalWarning storage-cli.js backup",
    "data:verify-recovery": "node --disable-warning=ExperimentalWarning storage-cli.js verify-recovery",
    "source:audit": "node source-audit-cli.js",
    "source:audit:apply": "node source-audit-cli.js --apply",
    "content:audit": "node content-audit-cli.js --write",
    "notes:migrate": "node article-note-migration-cli.js",
    "notes:migrate:apply": "node article-note-migration-cli.js --apply",
    "test:recovery": "node --disable-warning=ExperimentalWarning --test tests/local-data-store.test.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
