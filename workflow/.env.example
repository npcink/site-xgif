# Optional local multimodal embeddings. Use the native Ollama service root (no /v1).
# Keep Ollama bound to loopback; when it runs on M4, reach it through an SSH tunnel.
# Remote services must use HTTPS. Do not put credentials or tokens in either URL.
XGIF_EMBEDDING_BASE_URL=""
XGIF_EMBEDDING_PROVIDER="ollama"
XGIF_EMBEDDING_MODEL="RizwanMalik/qwen3-vl-embedding-2b:q8_0-q8_0"
XGIF_EMBEDDING_API_KEY=""
XGIF_EMBEDDING_TIMEOUT_MS="60000"
# Native multimodal requests run serially; batching applies only to legacy openai mode.
XGIF_EMBEDDING_BATCH_SIZE="1"

# New image uploads can use Cloudflare R2. Keep false until the bucket and custom domain are ready.
XGIF_R2_ENABLED="false"
XGIF_R2_BUCKET="xgif-memes-prod"
XGIF_R2_PUBLIC_BASE_URL="https://img.xgif.cn"

# Optional Wrangler binary override. Default: site/node_modules/.bin/wrangler
XGIF_WRANGLER_BIN=""

# Series candidates remain manual review items.
XGIF_SERIES_EMBEDDINGS="auto"
XGIF_EMBEDDING_SSH_TARGET=""
XGIF_EMBEDDING_SSH_REMOTE_PORT="11434"

# Independent pixel/theme comparisons; explicit opt-in, never auto-merge.
XGIF_SERIES_THEME="off"
XGIF_SERIES_VISION_PROVIDER="openai"
XGIF_SERIES_VISION_BASE_URL=""
XGIF_SERIES_VISION_MODEL=""
XGIF_SERIES_VISION_API_KEY=""
XGIF_SERIES_VISION_TIMEOUT_MS="120000"
# Bump revision after a provider-side model upgrade, or use REFRESH=1 for one run.
XGIF_SERIES_VISION_REVISION=""
XGIF_SERIES_VISION_REPORTED_MODEL_ALIASES="[]"
XGIF_SERIES_THEME_REFRESH="0"
