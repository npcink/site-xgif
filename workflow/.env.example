# OpenAI-compatible AI configuration for the local publisher.
XGIF_AI_API_KEY=""
XGIF_AI_MODEL=""

# Optional. Default: https://api.openai.com/v1
XGIF_AI_BASE_URL="https://api.openai.com/v1"

# Optional. Default: 45000
XGIF_AI_TIMEOUT_MS="45000"

# Optional deploy-preview URL shown in the system page after your preview provider is configured.
XGIF_DEPLOY_PREVIEW_URL=""

# flomo ZIP import limits (optional)
PUBLISHER_MAX_IMPORT_ZIP_BYTES="10485760"
PUBLISHER_MAX_IMPORT_UNCOMPRESSED_BYTES="52428800"

# Optional image-upload safeguards. Defaults: 8 MB; min 160 px; max 6000 px per side.
PUBLISHER_MAX_IMAGE_BYTES="8388608"
PUBLISHER_MIN_IMAGE_DIMENSION="160"
PUBLISHER_MAX_IMAGE_DIMENSION="6000"

# New image uploads can use Cloudflare R2. Keep false until the bucket and custom domain are ready.
XGIF_R2_ENABLED="false"
XGIF_R2_BUCKET="xgif-memes-prod"
XGIF_R2_PUBLIC_BASE_URL="https://img.xgif.cn"

# Optional Wrangler binary override. Default: site/node_modules/.bin/wrangler
XGIF_WRANGLER_BIN=""
