# OpenAI-compatible AI configuration for the local publisher.
XGIF_AI_API_KEY=""
XGIF_AI_MODEL=""

# Optional. Default: https://api.openai.com/v1.
# Remote services must use HTTPS. HTTP is accepted only for loopback addresses.
XGIF_AI_BASE_URL="https://api.openai.com/v1"

# Optional. Default: 45000
XGIF_AI_TIMEOUT_MS="45000"

# Image galleries use only the M4/local vision endpoint. No fallback to article AI.
# Optional SSH transport reconnects on demand; requires an existing SSH key and reachable M4.
XGIF_IMAGE_AI_BASE_URL="http://127.0.0.1:11436/v1"
XGIF_IMAGE_AI_MODEL=""
# Optional model weights/version label; changing it invalidates recognition caches.
XGIF_IMAGE_AI_VERSION=""
XGIF_IMAGE_AI_API_KEY=""
XGIF_IMAGE_AI_TIMEOUT_MS="120000"
XGIF_IMAGE_AI_SSH_HOST=""

# Optional local OpenAI-compatible embedding endpoint.
# Keep Ollama bound to loopback; when it runs on M4, reach it through an SSH tunnel.
# Remote services must use HTTPS. Do not put credentials or tokens in either URL.
XGIF_EMBEDDING_BASE_URL=""
XGIF_EMBEDDING_MODEL=""
XGIF_EMBEDDING_API_KEY=""
XGIF_EMBEDDING_TIMEOUT_MS="60000"
XGIF_EMBEDDING_BATCH_SIZE="16"

# Optional deploy-preview URL shown in the system page after your preview provider is configured.
XGIF_DEPLOY_PREVIEW_URL=""

# flomo ZIP import limits (optional)
PUBLISHER_MAX_IMPORT_ZIP_BYTES="10485760"
PUBLISHER_MAX_IMPORT_UNCOMPRESSED_BYTES="52428800"

# Optional image-upload safeguards. Defaults: 8 MB; min 160 px; max 6000 px per side.
PUBLISHER_MAX_IMAGE_BYTES="8388608"
PUBLISHER_MIN_IMAGE_DIMENSION="160"
PUBLISHER_MAX_IMAGE_DIMENSION="6000"

# New image uploads can use Cloudflare R2. Keep false until the bucket and custom domain are ready.
XGIF_R2_ENABLED="false"
XGIF_R2_BUCKET="xgif-memes-prod"
XGIF_R2_PUBLIC_BASE_URL="https://img.xgif.cn"

# Optional Wrangler binary override. Default: site/node_modules/.bin/wrangler
XGIF_WRANGLER_BIN=""
