# Optional local multimodal embeddings. Use the native Ollama service root (no /v1).
# Keep Ollama bound to loopback; when it runs on M4, reach it through an SSH tunnel.
# Remote services must use HTTPS. Do not put credentials or tokens in either URL.
XGIF_EMBEDDING_BASE_URL=""
XGIF_EMBEDDING_PROVIDER="ollama"
XGIF_EMBEDDING_MODEL="RizwanMalik/qwen3-vl-embedding-2b:q8_0-q8_0"
XGIF_EMBEDDING_API_KEY=""
XGIF_EMBEDDING_TIMEOUT_MS="60000"
# Native multimodal requests run serially; batching applies only to legacy openai mode.
XGIF_EMBEDDING_BATCH_SIZE="1"
# Optional on-demand SSH forwarding for image-series checks. Requires existing
# trusted host/key access; no password prompt or persistent background process.
# Set BASE_URL to http://127.0.0.1:11435. Leave TARGET empty for a local service.
XGIF_EMBEDDING_SSH_TARGET=""
XGIF_EMBEDDING_SSH_REMOTE_PORT="11434"
# Series checks read current original members and cache derived vectors only.
XGIF_SERIES_EMBEDDINGS="auto"

# Optional AI metadata reruns. Generation and review are separate from embeddings.
# openai = OpenAI-compatible Chat Completions; ollama = native loopback /api/chat.
# No model is silently substituted. Set VISION=true only for an image-capable model.
XGIF_AI_GENERATION_PROVIDER="openai"
XGIF_AI_GENERATION_BASE_URL="https://your-provider.example/v1"
XGIF_AI_GENERATION_MODEL=""
XGIF_AI_GENERATION_API_KEY=""
XGIF_AI_GENERATION_VISION="false"
# Optional provider-supplied immutable revision/digest for reproducibility.
XGIF_AI_GENERATION_REVISION=""
XGIF_AI_GENERATION_TIMEOUT_MS="120000"
XGIF_AI_GENERATION_MAX_OUTPUT_TOKENS="6000"
XGIF_AI_GENERATION_REASONING_EFFORT=""
# Review defaults to generation. To use another endpoint, configure its own key.
# XGIF_AI_REVIEW_PROVIDER="openai"
# XGIF_AI_REVIEW_BASE_URL="https://another-provider.example/v1"
# XGIF_AI_REVIEW_MODEL=""
# XGIF_AI_REVIEW_API_KEY=""
# XGIF_AI_REVIEW_VISION="true"
# XGIF_AI_REVIEW_REVISION=""

# New image uploads can use Cloudflare R2. Keep false until the bucket and custom domain are ready.
XGIF_R2_ENABLED="false"
XGIF_R2_BUCKET="xgif-memes-prod"
XGIF_R2_PUBLIC_BASE_URL="https://img.xgif.cn"

# Optional Wrangler binary override. Default: site/node_modules/.bin/wrangler
XGIF_WRANGLER_BIN=""

# 默认严格匹配响应的 model；只有核实供应商版本名称后才显式允许别名。
# 原生 Ollama 如返回 model:latest，也需明确列出；不隐式接受任何版本。
XGIF_AI_GENERATION_REPORTED_MODEL_ALIASES=[]
XGIF_AI_REVIEW_REPORTED_MODEL_ALIASES=[]

# Independent pixel/theme comparisons; explicit opt-in, never auto-merge.
XGIF_SERIES_THEME="off"
XGIF_SERIES_VISION_PROVIDER="openai"
XGIF_SERIES_VISION_BASE_URL=""
XGIF_SERIES_VISION_MODEL=""
XGIF_SERIES_VISION_API_KEY=""
XGIF_SERIES_VISION_TIMEOUT_MS="120000"
# Bump revision after a provider-side model upgrade, or use REFRESH=1 for one run.
XGIF_SERIES_VISION_REVISION=""
XGIF_SERIES_VISION_REPORTED_MODEL_ALIASES="[]"
XGIF_SERIES_THEME_REFRESH="0"
