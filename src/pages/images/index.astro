---
import { getCollection } from "astro:content";
import ImageCard from "../../components/ImageCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sortByDate } from "../../lib/content";

const images = sortByDate(
  (await getCollection("images")).filter((entry) => !entry.data.draft && entry.data.public),
);
const moods = Array.from(new Set(images.flatMap((entry) => entry.data.mood)));
---

<BaseLayout title="图片与表情包 — xgif.cn" description="按情绪、场景和标签整理的图片、GIF 与表情包。">
  <section class="archive-hero image-archive-hero">
    <p class="section-kicker">REACTIONS / 图片与表情包</p>
    <h1>不想解释，<br /><em>就发张图。</em></h1>
    <p>按情绪、场景和主题整理，找到刚好能表达这一刻的图片。</p>
  </section>

  <section class="archive-content">
    <div class="archive-toolbar">
      <label class="inline-search">
        <span>⌕</span>
        <input data-filter-input placeholder="搜索情绪、场景或标签…" aria-label="筛选图片" />
      </label>
      <div class="filter-chips">
        <button class="active" data-filter="">全部情绪</button>
        {moods.map((mood) => <button data-filter={mood.toLowerCase()}>{mood}</button>)}
      </div>
    </div>
    <p class="filter-count"><span data-visible-count>{images.length}</span> 张图片</p>
    <div class="masonry-grid" data-filter-list>
      {images.map((item) => <ImageCard item={item} />)}
    </div>
    <div class="empty-state" data-empty hidden>
      <span>¯\_(ツ)_/¯</span><h2>这次真的没有找到</h2><p>换个情绪或场景试试。</p>
    </div>
  </section>
  <script is:inline src="/scripts/filter.js"></script>
</BaseLayout>
