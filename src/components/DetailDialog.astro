<dialog class="detail-dialog" data-detail-dialog aria-label="内容详情">
  <button class="detail-dialog-close" type="button" data-detail-close aria-label="关闭详情">
    <b aria-hidden="true">×</b>
  </button>
  <div class="detail-dialog-shell" data-detail-shell>
    <div class="detail-dialog-loading" data-detail-loading role="status" aria-live="polite">
      <span aria-hidden="true"></span>
      <p>正在整理内容…</p>
    </div>
    <div class="detail-dialog-body" data-detail-body hidden></div>
  </div>
</dialog>

<script is:inline src="/scripts/detail-dialog.js"></script>
