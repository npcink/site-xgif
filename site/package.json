{
  "name": "xgif-astro-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run build && node --test tests/*.test.mjs && npm run test:links",
    "test:links": "node scripts/check-links.mjs",
    "test:production": "node scripts/production-smoke.mjs",
    "test:release-acceptance": "node scripts/release-acceptance.mjs",
    "test:gallery": "node scripts/test-gallery.mjs",
    "test:visual": "playwright test --config playwright.config.mjs",
    "test:visual:update": "playwright test --config playwright.config.mjs --update-snapshots",
    "test:visual:linux": "sh scripts/run-visual-baseline.sh",
    "test:visual:update:linux": "sh scripts/run-visual-baseline.sh --update-snapshots",
    "test:all": "npm run test && npm run test:visual && npm run test:gallery",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "stats:favorites": "node scripts/favorite-stats.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "astro": "7.4.12",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.20.1",
    "typescript": "5.9.3",
    "wrangler": "4.163.0"
  }
}
