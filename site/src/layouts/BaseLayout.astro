---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DetailDialog from "../components/DetailDialog.astro";
import { siteConfig } from "../config/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  pageType?: "website" | "article";
  jsonLd?: Record<string, unknown>;
}

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.description,
  image = siteConfig.defaultSocialImage,
  noindex = false,
  pageType = "website",
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(siteConfig.url);
const canonical = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL(image, siteUrl);
const rssUrl = new URL(siteConfig.rss.path, siteUrl);
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.rss.title} href={rssUrl} />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <DetailDialog />
    <script is:inline type="module" src="/scripts/favorites.js"></script>
  </body>
</html>
