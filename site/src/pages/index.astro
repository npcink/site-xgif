---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import ImageCard from "../components/ImageCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { allTags, contentHref, sortByDate } from "../lib/content";

const articles = sortByDate((await getCollection("articles")).filter((entry) => !entry.data.draft));
const images = sortByDate(
  (await getCollection("images")).filter((entry) => !entry.data.draft && entry.data.public),
);
const featured = articles.find((entry) => entry.data.featured) ?? articles[0];
const homeArticles = articles.slice(0, 8);
const homeImages = images.slice(0, 6);
const tags = allTags(articles, images);
const popularTags = ["AI", "互联网", "打工", "无语", "反转", "群聊", "职场", "观察"].filter((tag) =>
  tags.includes(tag),
);
---

<BaseLayout>
  <section class="hero" id="top">
    <div class="hero-copy reveal">
      <p class="eyebrow"><span></span> 轻内容，每日手工整理</p>
      <h1>值得看的，<br /><em>三分钟看懂。</em></h1>
      <p class="hero-intro">
        文章负责整理信息，图片负责表达情绪。<br />
        AI 帮忙归纳，最后由人决定什么值得留下。
      </p>
      <div class="hero-actions">
        <a class="primary-button" href="#discover">开始浏览 <span>↘</span></a>
        <span class="edition">人工复核 · 保留来源 · 持续更新</span>
      </div>
    </div>

    <div class="hero-feature reveal-late" aria-label="今日推荐">
      <div class="feature-topline"><span>今日推荐</span><span>01 / {String(articles.length).padStart(2, "0")}</span></div>
      <div class="feature-visual">
        <div class="feature-orbit orbit-one"></div>
        <div class="feature-orbit orbit-two"></div>
        <div class="feature-face">◉</div>
        <div class="feature-sticker">AI<br />观察</div>
      </div>
      <div class="feature-copy">
        <span class="mini-label">READ · {featured.data.readTime.toUpperCase()}</span>
        <h2>{featured.data.title}</h2>
        <a href={contentHref(featured)} data-detail-link data-detail-kind="article">阅读全文 <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="tag-ticker" aria-label="热门标签">
    <div class="ticker-label">本周热词</div>
    <div class="ticker-track">
      {popularTags.slice(0, 5).map((tag) => <a href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
    </div>
  </section>

  <section class="explore" id="discover">
    <div class="section-heading">
      <div>
        <p class="section-kicker">DISCOVER / 发现</p>
        <h2>今天有什么好东西？</h2>
      </div>
      <p>先从编辑摘要快速了解，也可以继续阅读完整正文。</p>
    </div>

    <div class="search-panel" data-home-discovery>
      <label class="search-box">
        <span aria-hidden="true">⌕</span>
        <input data-home-filter-input placeholder="搜索文章、图片、标签或来源…" aria-label="搜索内容" />
        <button type="button" data-home-filter-clear aria-label="清空搜索" hidden>×</button>
      </label>
      <div class="view-tabs" role="group" aria-label="内容类型">
        <button class="active" type="button" data-home-view="all" aria-pressed="true">全部</button>
        <button type="button" data-home-view="articles" aria-pressed="false">文章</button>
        <button type="button" data-home-view="images" aria-pressed="false">图片 / GIF</button>
      </div>
    </div>
    <p class="result-note" data-home-result-note aria-live="polite" hidden>关于“<span data-home-query></span>”找到 <strong data-home-visible-count>0</strong> 条内容</p>

    <div class="content-section" id="articles" data-home-section="articles">
      <div class="content-title">
        <h2>文章 <sup>{String(articles.length).padStart(2, "0")}</sup></h2>
        <a href="/articles">查看全部文章 →</a>
      </div>
      <div class="article-grid">
        {homeArticles.map((article, index) => <ArticleCard article={article} index={index} />)}
      </div>
    </div>

    <div class="content-section image-section" id="images" data-home-section="images">
      <div class="content-title">
        <h2>图片 / 表情包 <sup>{String(images.length).padStart(2, "0")}</sup></h2>
        <a href="/images">查看全部图片 →</a>
      </div>
      <div class="masonry-grid">
        {homeImages.map((item) => <ImageCard item={item} />)}
      </div>
    </div>

    <div class="empty-state" data-home-empty hidden>
      <span>¯\_(ツ)_/¯</span>
      <h3>这次真的什么都没搜到</h3>
      <p>换个更短的关键词，或者从热门标签开始。</p>
      <button type="button" data-home-reset>看看全部内容</button>
    </div>
  </section>

  <section class="tag-library" id="tags">
    <div class="tag-intro">
      <p class="section-kicker">INDEX / 标签索引</p>
      <h2>沿着标签，<br />继续逛下去。</h2>
      <p>主题、情绪和使用场景，共同把文章与表情包连接起来。</p>
    </div>
    <div class="tag-cloud">
      {popularTags.map((tag, index) => (
        <a href={`/tags/${encodeURIComponent(tag)}`}>
          <span>{String(index + 1).padStart(2, "0")}</span> {tag} <b>↗</b>
        </a>
      ))}
    </div>
  </section>

  <section class="newsletter">
    <div class="newsletter-mark">持续<br />更新</div>
    <div>
      <p class="section-kicker">EDITORIAL UPDATE</p>
      <h2>不用订阅，也能随时回来继续看。</h2>
      <p>当前站点不收集邮箱。新内容会直接进入文章和图片索引。</p>
    </div>
    <div class="newsletter-placeholder">
      <span>无需注册 · 不采集联系方式</span>
      <a href="/articles">浏览全部文章 <span>→</span></a>
    </div>
  </section>
  <script is:inline src="/scripts/home-discovery.js"></script>
</BaseLayout>
