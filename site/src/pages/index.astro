---
import { getPublicArticles } from "../lib/public-articles";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import ImageCard from "../components/ImageCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortByDate } from "../lib/content";
import { isGalleryChild } from "../config/image-collection";

const articles = sortByDate(await getPublicArticles());
const images = sortByDate(
  (await getCollection("images")).filter(({ data }) => !data.draft && data.public && !isGalleryChild(data.contentId)),
);
const homeArticles = articles.slice(0, 8);
const homeImages = images.slice(0, 6);
const tagCounts = new Map<string, number>();
for (const entry of [...articles, ...images]) {
  for (const tag of new Set(entry.data.tags)) tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
}
const popularTags = [...tagCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "zh-CN")).slice(0, 7).map(([tag]) => tag);
type FeedItem = { kind: "articles"; article: typeof articles[number] } | { kind: "images"; image: typeof images[number] };
const feed: FeedItem[] = [];
for (let index = 0; index < Math.max(homeImages.length, Math.ceil(homeArticles.length / 2)); index += 1) {
  if (homeImages[index]) feed.push({ kind: "images", image: homeImages[index] });
  for (const article of homeArticles.slice(index * 2, index * 2 + 2)) feed.push({ kind: "articles", article });
}
---

<BaseLayout>
  <section class="home-discovery" id="discover" aria-labelledby="top" data-home-discovery>
    <header class="home-feed-heading">
      <h1 id="top">最近更新</h1>
      <div class="view-tabs" role="group" aria-label="内容类型" data-home-views hidden>
        <button type="button" data-home-view="all" aria-controls="home-feed" aria-pressed="true">全部</button>
        {homeArticles.length > 0 && <button type="button" data-home-view="articles" aria-controls="home-feed" aria-pressed="false">文章</button>}
        {homeImages.length > 0 && <button type="button" data-home-view="images" aria-controls="home-feed" aria-pressed="false">图片 / GIF</button>}
      </div>
    </header>
    <p class="sr-only" data-home-status role="status"></p>
    <div class="home-feed" id="home-feed">
      {feed.map((entry, index) => (
        <div class="home-feed-item" data-home-section={entry.kind}>
          {entry.kind === "articles" ? <ArticleCard article={entry.article} index={index} headingLevel="h2" /> : <ImageCard item={entry.image} priority={index === 0} layout="home" headingLevel="h2" />}
        </div>
      ))}
    </div>
    <nav class="home-feed-more" aria-label="浏览完整列表">
      <a href="/articles" data-home-more="articles">全部文章 <Icon name="arrow-right" class="inline-icon" /></a>
      <a href="/images" data-home-more="images">全部图片 <Icon name="arrow-right" class="inline-icon" /></a>
    </nav>
  </section>

  <section class="tag-library" id="tags">
    <div class="tag-intro">
      <p class="section-kicker">INDEX / 标签索引</p>
      <h2>沿着标签，<wbr /><span>继续逛下去。</span></h2>
      <p>主题、情绪和使用场景，共同把文章与表情包连接起来。</p>
    </div>
    <div class="tag-cloud">
      {popularTags.map((tag, index) => (
        <a href={`/tags/${encodeURIComponent(tag)}`}>
          <span>{String(index + 1).padStart(2, "0")}</span> {tag} <b><Icon name="arrow-up-right" class="inline-icon" /></b>
        </a>
      ))}
    </div>
  </section>

  <script is:inline defer src="/scripts/home-discovery.js"></script>
</BaseLayout>
