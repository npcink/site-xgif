---
import { getPublicArticles } from "../../lib/public-articles";
import { getPublicImages } from "../../lib/public-images";
import Icon from "../../components/Icon.astro";
import { pageTitle } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ListPagination from "../../components/ListPagination.astro";
import { contentHref } from "../../lib/content";
import { foodStallGallery, isGalleryChild } from "../../config/image-collection";

const [articles, images] = await Promise.all([
  getPublicArticles(),
  getPublicImages(),
]);
const catalog = [
  ...articles.map((entry) => ({
    contentId: entry.data.contentId,
    kind: "article",
    title: entry.data.title,
    href: contentHref(entry),
  })),
  ...images.filter(({ data }) => !isGalleryChild(data.contentId)).map((entry) => ({
    contentId: entry.data.contentId,
    kind: "image",
    title: entry.data.contentId === foodStallGallery.cover ? foodStallGallery.title : entry.data.title,
    href: contentHref(entry),
    gallery: entry.data.contentId === foodStallGallery.cover || Boolean(entry.data.images?.length && entry.data.images.length > 1),
  })),
];
const safeCatalog = JSON.stringify(catalog).replaceAll("<", "\\u003c");
---

<BaseLayout title={pageTitle("本地收藏")} description="保存在当前浏览器中的 XGIF 文章与图片收藏。" noindex>
  <section class="favorites-page" data-favorites-page>
    <header class="favorites-heading">
      <h1>本地收藏</h1>
      <p>收藏只保存在当前浏览器。</p>
    </header>

    <noscript>
      <p class="no-script-note">启用 JavaScript 后即可查看保存在此浏览器的收藏。</p>
      <nav class="tag-jump-links" aria-label="浏览内容">
        <a href="/articles">浏览文章</a>
        <a href="/images">浏览图片</a>
      </nav>
    </noscript>

    <div class="favorites-toolbar" aria-label="收藏管理" hidden>
      <p data-favorites-summary>正在读取本地收藏…</p>
      <div class="favorites-actions">
        <button type="button" data-favorites-export>导出 JSON</button>
        <button type="button" data-favorites-import="merge">导入并合并</button>
        <button class="quiet-button" type="button" data-favorites-import="replace">覆盖导入</button>
        <button class="quiet-button" type="button" data-favorites-clear-unavailable hidden>清理不可用项</button>
      </div>
    </div>
    <input type="file" accept="application/json,.json" data-favorites-file hidden />

    <p class="favorites-status" data-favorites-status role="status" aria-live="polite" hidden></p>
    <div class="favorites-list" data-favorites-list></div>
    <ListPagination label="收藏分页" />
    <div class="favorites-empty" data-favorites-empty hidden>
      <Icon name="heart" />
      <h2>收藏夹还是空的</h2>
      <p>打开任意文章或图片详情，点击“收藏”即可加入这里。</p>
      <div class="favorites-empty-actions">
        <a href="/articles">去逛文章 <Icon name="arrow-right" class="inline-icon" /></a>
        <a href="/images">去逛图片 <Icon name="arrow-right" class="inline-icon" /></a>
        <button type="button" data-favorites-import="merge">导入备份</button>
      </div>
    </div>
  </section>
  <script is:inline type="application/json" data-favorites-catalog set:html={safeCatalog}></script>
  <script is:inline type="module" src="/scripts/favorites-page.js"></script>
</BaseLayout>
