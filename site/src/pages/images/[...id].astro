---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("images")).filter((entry) => !entry.data.draft && entry.data.public);
  return entries.map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props {
  item: CollectionEntry<"images">;
}

const { item } = Astro.props;
const { Content } = await render(item);
const allArticles = (await getCollection("articles")).filter((entry) => !entry.data.draft);
const relatedArticles = allArticles
  .filter((entry) => entry.data.tags.some((tag) => item.data.tags.includes(tag)))
  .slice(0, 2);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  name: item.data.title,
  description: item.data.description,
  contentUrl: item.data.image,
  creditText: item.data.author,
  license: item.data.licenseUrl,
  acquireLicensePage: item.data.sourceUrl,
  datePublished: item.data.pubDate.toISOString(),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout title={`${item.data.title} — xgif.cn`} description={item.data.description} image={item.data.image} {jsonLd}>
  <article class="detail-page image-detail" data-detail-content data-detail-kind="image">
    <a class="back-link" href="/images/">← 返回图片库</a>
    <div class="image-detail-grid">
      <figure class:list={[`ratio-${item.data.ratio}`]}>
        <img src={item.data.image} alt={item.data.title} />
      </figure>
      <div class="image-detail-copy">
        <p class="section-kicker">REACTION / 图片详情</p>
        <h1>{item.data.title}</h1>
        <p class="detail-summary">{item.data.description}</p>
        <dl>
          <div><dt>分类</dt><dd>{item.data.category}</dd></div>
          <div><dt>情绪</dt><dd>{item.data.mood.join(" / ") || "未分类"}</dd></div>
          <div><dt>场景</dt><dd>{item.data.scenes.join(" / ") || "通用"}</dd></div>
        </dl>
        <div class="card-tags">
          {item.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
        </div>
        <div class="prose image-note"><Content /></div>
        <p class="image-source">图片来源备注：{item.data.source}</p>
      </div>
    </div>
  </article>

  {relatedArticles.length > 0 && (
    <section class="related-section">
      <div class="content-title"><h2>相关文章</h2><a href="/articles/">更多文章 →</a></div>
      <div class="article-grid">
        {relatedArticles.map((article, index) => <ArticleCard article={article} index={index} />)}
      </div>
    </section>
  )}
</BaseLayout>
