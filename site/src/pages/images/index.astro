---
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import ImageCard from "../../components/ImageCard.astro";
import ListPagination from "../../components/ListPagination.astro";
import CatalogStatus from "../../components/CatalogStatus.astro";
import { getCatalog } from "../../lib/catalog";
import { pageTitle } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sortByDate } from "../../lib/content";

const images = sortByDate(
  (await getCollection("images")).filter((entry) => !entry.data.draft && entry.data.public),
);
const catalog = await getCatalog();
---

<BaseLayout title={pageTitle("图片与表情包")} description="按情绪、场景和标签整理的图片、GIF 与表情包。">
  <section class="archive-hero image-archive-hero">
    <p class="section-kicker">REACTIONS / 图片与表情包</p>
    <h1><span>不想解释，</span><wbr /><em>就发张图。</em></h1>
    <p>按情绪、场景和主题整理，找到刚好能表达这一刻的图片。</p>
  </section>

  <section class="archive-content" data-list-scope data-catalog-base={catalog.base} data-catalog-kind="images" data-catalog-total={images.length}>
    <div class="media-filter" role="group" aria-label="图片类型" data-filter-controls hidden>
      <button type="button" data-media-filter="" aria-pressed="true" class="active">全部</button>
      <button type="button" data-media-filter="static" aria-pressed="false">静态图</button>
      <button type="button" data-media-filter="animated" aria-pressed="false">动图</button>
    </div>
    <div class="archive-toolbar" data-filter-controls hidden>
      <label class="inline-search">
        <Icon name="search" />
        <input data-filter-input placeholder="搜索情绪、场景或标签…" aria-label="筛选图片" />
      </label>
    </div>
    <p class="filter-count" aria-live="polite"><span data-page-summary></span><span data-visible-count>{images.length}</span> 项内容</p>
    <CatalogStatus />
    <div class="masonry-grid" data-filter-list>
      {images.slice(0, 24).map((item, index) => <ImageCard item={item} headingLevel="h2" priority={index === 0} />)}
    </div>
    <ListPagination label="图片分页" />
    <noscript><p><a href="/browse/images/1">逐页浏览全部图片 <Icon name="arrow-right" class="inline-icon" /></a></p></noscript>
    <div class="empty-state" data-empty hidden>
      <span>¯\_(ツ)_/¯</span><h2>这次真的没有找到</h2><p>换个情绪或场景试试。</p>
    </div>
  </section>
  <script is:inline type="module" src="/scripts/filter.js"></script>
</BaseLayout>
