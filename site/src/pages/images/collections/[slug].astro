---
import { getPublicImages } from "../../../lib/public-images";
import type { InferGetStaticPropsType } from "astro";
import GalleryThumbnails from "../../../components/GalleryThumbnails.astro";
import ImageGallery from "../../../components/ImageGallery.astro";
import { imageCollections } from "../../../config/image-collection";
import { pageTitle } from "../../../config/site";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const publicImages = await getPublicImages();
  const byId = new Map(publicImages.map((image) => [image.data.contentId, image]));
  return imageCollections.map((collection) => ({
    params: { slug: collection.slug },
    props: {
      collection,
      members: collection.members.map(({ id, caption }) => {
        const entry = byId.get(id);
        if (!entry) throw new Error(`Missing public member ${id} in ${collection.slug}`);
        return { entry, caption };
      }),
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { collection, members } = Astro.props;
const galleryImages = members.map(({ entry, caption }) => ({
  src: entry.data.image,
  width: entry.data.width,
  height: entry.data.height,
  altText: entry.data.altText || entry.data.title,
  animated: entry.data.animated,
  caption,
  attribution: [entry.data.upscale === "lanczos" ? "Lanczos 放大版" : entry.data.upscale === "real-esrgan" ? "AI 超分版" : "", entry.data.source].filter(Boolean).join(" · "),
}));
---

<BaseLayout title={pageTitle(collection.title)} description={collection.description} image={members[0].entry.data.image}>
  <section class="detail-page curated-collection">
    <a class="back-link" href="/images">返回图片库</a>
    <p class="section-kicker">图集 · {galleryImages.length} 张</p>
    <h1 id="collection-title">{collection.title}</h1>
    <p>{collection.description}</p>
    <div class="collection-gallery" role="region" aria-labelledby="collection-title" data-collection-gallery data-image-gallery data-current="0">
      <ImageGallery images={galleryImages} title={collection.title} />
      <GalleryThumbnails images={galleryImages} />
    </div>
    {members.some(({ entry }) => entry.data.sourceKind === "unknown") && <a class="collection-rights" href="/rights">权利人投诉与下架</a>}
  </section>
</BaseLayout>

<style>
  .curated-collection .back-link { margin-bottom: 28px; }
  h1 { margin: 0; font-size: 2rem; }
  .collection-gallery { max-width: 960px; margin: 30px auto 0; }
  .collection-gallery :global(.gallery-stage) { height: min(62svh, 680px); }
  .collection-gallery :global(.gallery-caption) { margin: 0; padding: 10px 12px 0; font-size: .875rem; }
  .collection-gallery :global(.gallery-attribution) { margin: 0; padding: 4px 12px 10px; color: var(--muted); font-size: .875rem; }
  .collection-rights { display: inline-block; margin-top: 10px; font-size: .875rem; }
  @media (max-width: 720px) {
    .collection-gallery { margin-top: 24px; }
    .collection-gallery :global(.gallery-stage) { height: min(58svh, 520px); }
  }
</style>
