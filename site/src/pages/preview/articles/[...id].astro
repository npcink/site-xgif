---
import { getCollection, type CollectionEntry } from "astro:content";
import ArticleDetailPage from "../../../components/ArticleDetailPage.astro";
import { pageTitle } from "../../../config/site";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const entries = await getCollection("articles");
  return entries.map((article) => ({ params: { id: article.data.contentId }, props: { article } }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
---

<BaseLayout
  title={pageTitle(`本地预览：${article.data.title}`)}
  description={article.data.summary}
  image={article.data.coverImage}
  pageType="article"
  noindex
>
  <ArticleDetailPage {article} preview />
</BaseLayout>
