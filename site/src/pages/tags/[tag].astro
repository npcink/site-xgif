---
import Icon from "../../components/Icon.astro";
import { getCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import ImageCard from "../../components/ImageCard.astro";
import ListPagination from "../../components/ListPagination.astro";
import CatalogStatus from "../../components/CatalogStatus.astro";
import { getCatalog } from "../../lib/catalog";
import { pageTitle } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allTags, sortByDate } from "../../lib/content";

export async function getStaticPaths() {
  const articles = (await getCollection("articles")).filter((entry) => !entry.data.draft && !entry.data.publicationHold);
  const images = (await getCatalog()).images;
  return allTags(articles, images).map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const catalog = await getCatalog();
const articles = sortByDate(
  (await getCollection("articles")).filter((entry) => !entry.data.draft && !entry.data.publicationHold && entry.data.tags.includes(tag)),
);
const images = catalog.images.filter(({ data }) => data.tags.includes(tag));
const contentKinds = [articles.length > 0 ? "文章" : "", images.length > 0 ? "图片" : ""].filter(Boolean);
const description = `浏览「${tag}」标签下的${contentKinds.join("与")}。`;
---

<BaseLayout title={pageTitle(`#${tag}`)} {description}>
  <section class="tag-detail-hero">
    <a class="back-link" href="/tags"><Icon name="arrow-left" class="inline-icon" /> 全部标签</a>
    <div class="tag-detail-main">
      <h1>#{tag}</h1>
      {articles.length > 0 && images.length > 0 ? (
        <nav class="tag-jump-links" aria-label="标签内容">
          <a href="#tag-articles">{articles.length} 篇文章 <Icon name="arrow-down" class="inline-icon" /></a>
          <a href="#tag-images">{images.length} 项图片 <Icon name="arrow-down" class="inline-icon" /></a>
        </nav>
      ) : <p class="tag-result-count">{articles.length > 0 ? `${articles.length} 篇文章` : `${images.length} 项图片`}</p>}
    </div>
  </section>
  <CatalogStatus />
  <section class="archive-content tag-results" data-filter-list>
    {articles.length > 0 && (
      <section class="content-section" id="tag-articles" tabindex="-1" aria-labelledby="tag-articles-title" data-list-scope data-catalog-base={catalog.base} data-catalog-kind="articles" data-catalog-tag={tag} data-catalog-total={articles.length}>
        <h2 id="tag-articles-title" class="sr-only">相关文章</h2>
        <span class="sr-only" data-page-summary="range-only" aria-live="polite"></span>
        <div class="article-grid">{articles.slice(0, 24).map((article, index) => <ArticleCard article={article} index={index} />)}</div>
        <ListPagination label="标签文章分页" pageParam="articlesPage" />
      </section>
    )}
    {images.length > 0 && (
      <section class="content-section image-section" id="tag-images" tabindex="-1" aria-labelledby="tag-images-title" data-list-scope data-catalog-base={catalog.base} data-catalog-kind="images" data-catalog-tag={tag} data-catalog-total={images.length}>
        <h2 id="tag-images-title" class="sr-only">相关图片</h2>
        <span class="sr-only" data-page-summary="range-only" aria-live="polite"></span>
        <div class="masonry-grid">{images.slice(0, 24).map((item) => <ImageCard item={item} />)}</div>
        <ListPagination label="标签图片分页" pageParam="imagesPage" />
      </section>
    )}
    <noscript><p><a href="/browse/articles/1">逐页浏览全部文章</a> · <a href="/browse/images/1">逐页浏览全部图片</a></p></noscript>
  </section>
  <script is:inline type="module" src="/scripts/filter.js"></script>
</BaseLayout>
