---
import Icon from "../components/Icon.astro";
import ListPagination from "../components/ListPagination.astro";
import CatalogStatus from "../components/CatalogStatus.astro";
import { getCatalog } from "../lib/catalog";
import { pageTitle } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { cardImageSizes } from "../lib/card-image-sizes.mjs";

const catalog = await getCatalog();
---

<BaseLayout title={pageTitle("搜索")} description="搜索文章原文、图片说明、标签与来源。" noindex>
  <section class="search-page" data-query-required>
    <h1>搜索</h1>
    <div class="search-page-input" data-filter-controls hidden>
      <label for="site-search"><Icon name="search" /></label>
      <input id="site-search" data-filter-input placeholder="正文、图片说明、标签或来源" aria-label="搜索内容" />
      <button type="button" data-clear aria-label="清空搜索"><Icon name="close" /></button>
    </div>
    <p class="filter-count sr-only" aria-live="polite" data-search-announcement hidden>找到 <span data-visible-count>0</span> 条内容</p>

    <noscript><p class="no-script-note">搜索需要启用 JavaScript。你也可以直接浏览文章或图片。</p></noscript>
    <nav class="tag-jump-links search-links" aria-label="浏览内容" data-search-browse>
      <a href="/articles">浏览文章</a>
      <a href="/images">浏览图片</a>
    </nav>
    <CatalogStatus />
    <nav class="tag-jump-links search-links" aria-label="跳转到搜索结果" data-search-jump hidden>
      <a href="#search-articles">看文章</a>
      <a href="#search-images">看图片</a>
    </nav>
    <div data-filter-list>
      <section class="content-section search-group" id="search-articles" tabindex="-1" aria-labelledby="search-articles-title" data-search-group data-list-scope data-catalog-base={catalog.base} data-catalog-kind="articles" data-catalog-total={catalog.articles.length} hidden>
        <div class="content-title result-section-title">
          <h2 id="search-articles-title">文章</h2>
          <span data-group-total><span data-group-count>0</span> 篇</span>
          <span class="sr-only" aria-live="polite" data-page-summary="range-only"></span>
        </div>
        <div class="article-grid"></div>
        <ListPagination label="搜索文章分页" pageParam="articlesPage" />
      </section>
      <section class="content-section image-section search-group" id="search-images" tabindex="-1" aria-labelledby="search-images-title" data-search-group data-list-scope data-catalog-base={catalog.base} data-catalog-kind="images" data-catalog-total={catalog.images.length} data-catalog-image-sizes={`auto, ${cardImageSizes("search")}`} hidden>
        <div class="content-title result-section-title">
          <h2 id="search-images-title">图片 / 表情包</h2>
          <span data-group-total><span data-group-count>0</span> 项</span>
          <span class="sr-only" aria-live="polite" data-page-summary="range-only"></span>
        </div>
        <div class="masonry-grid"></div>
        <ListPagination label="搜索图片分页" pageParam="imagesPage" />
      </section>
    </div>
    <div class="search-empty" data-empty hidden>
      <h2>没有找到相关内容</h2>
    </div>
  </section>
  <script is:inline type="module" src="/scripts/filter.js"></script>
</BaseLayout>
