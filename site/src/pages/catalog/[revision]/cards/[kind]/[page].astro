---
import ArticleCard from "../../../../../components/ArticleCard.astro";
import ImageCard from "../../../../../components/ImageCard.astro";
import { catalogSizes, getCatalog, type CatalogKind } from "../../../../../lib/catalog";

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return (["articles", "images"] as CatalogKind[]).flatMap(kind =>
    Array.from({ length: Math.ceil(catalog[kind].length / catalogSizes[kind]) }, (_, index) => ({
      params: { revision: catalog.revision, kind, page: String(index + 1) },
      props: { kind, page: index + 1 },
    })));
}
const { kind, page } = Astro.props;
const catalog = await getCatalog();
const start = (page - 1) * catalogSizes[kind];
---
<section data-catalog-fragment data-revision={catalog.revision} data-kind={kind}>
  {kind === "articles"
    ? catalog.articles.slice(start, start + catalogSizes.articles).map((article, index) => <ArticleCard article={article} index={start + index} headingLevel="h2" />)
    : catalog.images.slice(start, start + catalogSizes.images).map(item => <ImageCard item={item} deferred />)}
</section>
