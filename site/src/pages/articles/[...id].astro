---
import { getCollection, type CollectionEntry } from "astro:content";
import ArticleDetailPage from "../../components/ArticleDetailPage.astro";
import { pageTitle, siteConfig } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { contentHref } from "../../lib/content";

export async function getStaticPaths() {
  const entries = (await getCollection("articles")).filter((entry) => !entry.data.draft);
  return entries.map((article) => ({ params: { id: article.data.contentId }, props: { article } }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const canonicalPath = contentHref("articles", article);
const siteUrl = Astro.site ?? new URL(siteConfig.url);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.data.title,
  description: article.data.summary,
  ...(article.data.coverImage
    ? { image: new URL(article.data.coverImage, siteUrl).href }
    : {}),
  datePublished: article.data.pubDate.toISOString(),
  publisher: { "@type": "Organization", name: siteConfig.publisherName, url: siteUrl.href },
  ...(article.data.sourceKind === "original"
    ? { author: { "@type": "Organization", name: siteConfig.publisherName } }
    : {}),
  ...(article.data.sourceUrl
    ? { isBasedOn: article.data.sourceUrl, citation: article.data.sourceUrl }
    : {}),
  mainEntityOfPage: new URL(canonicalPath, siteUrl).href,
};
---

<BaseLayout
  title={pageTitle(article.data.title)}
  description={article.data.summary}
  image={article.data.coverImage}
  pageType="article"
  {jsonLd}
>
  <ArticleDetailPage {article} />
</BaseLayout>
