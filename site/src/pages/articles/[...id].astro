---
import { getCollection, type CollectionEntry } from "astro:content";
import ArticleDetailPage from "../../components/ArticleDetailPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { contentHref } from "../../lib/content";

export async function getStaticPaths() {
  const entries = (await getCollection("articles")).filter((entry) => !entry.data.draft);
  return entries.map((article) => ({ params: { id: article.data.contentId }, props: { article } }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const canonicalPath = contentHref("articles", article);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.data.title,
  description: article.data.summary,
  datePublished: article.data.pubDate.toISOString(),
  publisher: { "@type": "Organization", name: "xgif.cn", url: Astro.site?.href || "https://www.xgif.cn/" },
  ...(article.data.sourceKind === "original"
    ? { author: { "@type": "Organization", name: "xgif.cn" } }
    : {}),
  ...(article.data.sourceUrl
    ? { isBasedOn: article.data.sourceUrl, citation: article.data.sourceUrl }
    : {}),
  mainEntityOfPage: new URL(canonicalPath, Astro.site).href,
};
---

<BaseLayout title={`${article.data.title} — xgif.cn`} description={article.data.summary} pageType="article" {jsonLd}>
  <ArticleDetailPage {article} />
</BaseLayout>
