---
import { getCollection, type CollectionEntry } from "astro:content";
import ArticleDetailPage from "../../components/ArticleDetailPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("articles")).filter((entry) => !entry.data.draft);
  return entries.map((article) => ({ params: { id: article.id }, props: { article } }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.data.title,
  description: article.data.summary,
  datePublished: article.data.pubDate.toISOString(),
  author: { "@type": "Organization", name: article.data.source },
  ...(article.data.sourceUrl ? { isBasedOn: article.data.sourceUrl } : {}),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout title={`${article.data.title} — xgif.cn`} description={article.data.summary} pageType="article" {jsonLd}>
  <ArticleDetailPage {article} />
</BaseLayout>
