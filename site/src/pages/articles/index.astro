---
import { getCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sortByDate } from "../../lib/content";

const articles = sortByDate((await getCollection("articles")).filter((entry) => !entry.data.draft));
const sources = Array.from(new Set(articles.map((entry) => entry.data.source)));
---

<BaseLayout title="文章 — xgif.cn" description="通过编辑摘要快速了解，也可以阅读完整正文并核对来源。">
  <section class="archive-hero">
    <p class="section-kicker">ARTICLES / 文章</p>
    <h1>先看懂重点，<br /><em>再决定是否读完。</em></h1>
    <p>保留编辑摘要、完整正文、来源链接与编辑判断。</p>
  </section>

  <section class="archive-content">
    <div class="archive-toolbar">
      <label class="inline-search">
        <span>⌕</span>
        <input data-filter-input placeholder="搜索标题、来源或标签…" aria-label="筛选文章" />
      </label>
      <div class="filter-chips">
        <button class="active" data-filter="">全部来源</button>
        {sources.map((source) => <button data-filter={source.toLowerCase()}>{source}</button>)}
      </div>
    </div>
    <p class="filter-count" aria-live="polite">
      <span data-page-summary>显示 1–{Math.min(12, articles.length)}，共 </span><span data-visible-count>{articles.length}</span> 篇文章
    </p>
    <div class="article-grid" data-filter-list>
      {articles.map((article, index) => <ArticleCard article={article} index={index} />)}
    </div>
    <nav class="archive-pagination" data-pagination data-page-size="12" aria-label="文章分页" hidden>
      <button type="button" data-page-prev>上一页</button>
      <div data-page-numbers></div>
      <button type="button" data-page-next>下一页</button>
    </nav>
    <div class="empty-state" data-empty hidden>
      <span>¯\_(ツ)_/¯</span><h2>暂时没有匹配的文章</h2><p>换个更短的关键词试试。</p>
    </div>
  </section>
  <script is:inline src="/scripts/filter.js"></script>
</BaseLayout>
