---
import DisplayImage from "./DisplayImage.astro";
interface Props {
  images: { src: string; width?: number; height?: number; altText?: string; animated?: boolean; caption?: string; attribution?: string }[];
  title: string;
}
const { images, title } = Astro.props;
---

<div class="public-image-gallery">
  <figure class="gallery-stage" data-gallery-stage>
    {images.map((image, index) => (
      <div data-gallery-slide data-gallery-caption={image.caption} data-gallery-attribution={image.attribution} data-image-ratio={image.width && image.height ? `${image.width}x${image.height}` : undefined} hidden={index !== 0}>
        <DisplayImage src={image.src} alt={image.altText || `${title} · 第 ${index + 1} 张`} width={image.width} height={image.height} animated={image.animated} detail priority={index === 0} deferred={index !== 0} />
      </div>
    ))}
    <span class="gallery-loading" data-gallery-loading role="status" hidden>正在加载图片…</span>
  </figure>
  {images.some((image) => image.caption) && <p class="gallery-caption" data-gallery-caption-output>{images[0]?.caption}</p>}
  {images.some((image) => image.attribution) && <p class="gallery-attribution" data-gallery-attribution-output hidden={!images[0]?.attribution}>{images[0]?.attribution}</p>}
</div>
