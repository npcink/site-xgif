---
import Icon from "./Icon.astro";
import { siteConfig } from "../config/site";

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${siteConfig.name} 首页`}>
    {siteConfig.brand.base}<span>{siteConfig.brand.suffix}</span>
  </a>
  <nav class="desktop-nav" aria-label="主导航">
    {siteConfig.mainNavigation.map((link) => (
      <a href={link.href} aria-current={pathname.startsWith(link.href) ? "page" : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="header-tools">
    <a class="header-favorites" href="/favorites" aria-current={pathname.startsWith("/favorites") ? "page" : undefined}>
      <Icon name="heart" /><span class="header-tool-label">收藏</span> <span data-favorites-count hidden>0</span>
    </a>
    <a class="header-search" href="/search">
      <Icon name="search" /><span class="header-tool-label">搜一搜</span>
    </a>
  </div>
  <details class="mobile-nav">
    <summary><span class="sr-only">菜单</span><Icon name="menu" /><Icon name="close" /></summary>
    <nav aria-label="移动端主导航">
      {siteConfig.mainNavigation.map((link) => (
        <a href={link.href} aria-current={pathname.startsWith(link.href) ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>
  </details>
</header>
