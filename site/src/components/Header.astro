---
import { siteConfig } from "../config/site";

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${siteConfig.name} 首页`}>
    {siteConfig.brand.base}<span>{siteConfig.brand.suffix}</span>
  </a>
  <nav class="desktop-nav" aria-label="主导航">
    {siteConfig.mainNavigation.map((link) => (
      <a href={link.href} aria-current={pathname.startsWith(link.href) ? "page" : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="header-tools">
    <a class="header-favorites" href="/favorites" aria-current={pathname.startsWith("/favorites") ? "page" : undefined}>
      收藏 <span data-favorites-count hidden>0</span>
    </a>
    <a class="header-search" href="/search">
      <span aria-hidden="true">⌕</span> 搜一搜
    </a>
  </div>
  <details class="mobile-nav">
    <summary>菜单 <span aria-hidden="true">+</span></summary>
    <nav aria-label="移动端主导航">
      {siteConfig.mainNavigation.map((link) => (
        <a href={link.href} aria-current={pathname.startsWith(link.href) ? "page" : undefined}>{link.label}</a>
      ))}
      <a href="/favorites">本地收藏 <span data-favorites-count hidden>0</span></a>
      <a href="/search">搜索内容</a>
    </nav>
  </details>
</header>
