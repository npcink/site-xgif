---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { cardImageSizes } from "../lib/card-image-sizes.mjs";

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  thumbnail?: boolean;
  detail?: boolean;
  priority?: boolean;
  deferred?: boolean;
  deferCard?: boolean;
  animated?: boolean;
  layout?: "archive" | "home" | "search" | "recommendation";
}

const { src, alt, width, height, thumbnail = false, detail = false, priority = false, deferred = false, deferCard = false, animated = false, layout = "archive" } = Astro.props;
const localImages = import.meta.glob<ImageMetadata>("/public/images/**/*.{jpg,jpeg,png,webp,gif}", { eager: true, import: "default" });
const local = localImages[`/public${src}`];
const canOptimize = Boolean(local || (src.startsWith("https://img.xgif.cn/memes/") && width && height));
const firstFrame = thumbnail || (animated && !detail);
const candidates = thumbnail ? [120] : animated && detail ? [480, 640] : detail ? [640, 960, 1280] : [320, 640, 960];
const widths = [...new Set(candidates.map((size) => Math.min(size, width || size)))];
const display = canOptimize ? await getImage({
  src: local || src,
  width: widths.at(-1),
  height: width && height ? Math.round(widths.at(-1)! * height / width) : undefined,
  widths,
  format: "webp",
  // Only moving detail copies use the smaller encoding; posters keep text sharp.
  quality: animated && detail && !firstFrame ? 68 : 82,
  firstFrame,
}) : undefined;
const displaySrc = display?.src || src;
const srcset = display?.srcSet.attribute || undefined;
// Match CSS columns and container caps. Lazy images use their measured slot where
// sizes=auto is supported, including narrower recommendation and dialog surfaces.
const fallbackSizes = thumbnail ? "60px" : detail ? "(max-width: 900px) 90vw, 55vw" : cardImageSizes(layout);
const sizes = priority || thumbnail ? fallbackSizes : `auto, ${fallbackSizes}`;
---

<img
  src={deferred || deferCard ? undefined : displaySrc}
  srcset={deferred || deferCard ? undefined : srcset}
  data-card-src={deferCard ? displaySrc : undefined}
  data-card-srcset={deferCard ? srcset : undefined}
  data-gallery-src={deferred ? displaySrc : undefined}
  data-gallery-srcset={deferred ? srcset : undefined}
  sizes={sizes}
  data-animation-poster={animated && !detail ? "" : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : undefined}
  decoding="async"
  referrerpolicy="no-referrer"
/>
