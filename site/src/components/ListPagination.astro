---
interface Props {
  label: string;
  pageSize?: number;
  pageParam?: string;
  compact?: boolean;
}
const { label, pageSize = 24, pageParam = "page", compact = false } = Astro.props;
---

<nav class:list={["archive-pagination", { "archive-pagination--compact": compact }]} data-pagination data-page-size={pageSize} data-page-param={pageParam} aria-label={label} hidden>
  <button type="button" data-page-prev>上一页</button>
  <div data-page-numbers></div>
  <span class="page-position" data-page-position></span>
  <button type="button" data-page-next>下一页</button>
</nav>
