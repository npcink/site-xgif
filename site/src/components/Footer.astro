---
import { siteConfig } from "../config/site";
---

<footer>
  <div class="footer-main">
    <div class="footer-identity">
      <div class="footer-brand">{siteConfig.brand.base}<span>{siteConfig.brand.suffix}</span></div>
      <p>有趣的信息，被认真地整理。</p>
    </div>
    <nav class="footer-nav" aria-label="页脚导航">
      {siteConfig.footerNavigation.map((group, index) => (
        <div>
          <p class="footer-nav-label" id={`footer-nav-${index}`}>{group.label}</p>
          <ul class="footer-links" aria-labelledby={`footer-nav-${index}`}>
            {group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} {siteConfig.name}</span>
    <span>AI 辅助整理 · 人工确认发布</span>
  </div>
</footer>
