---
import { siteConfig } from "../config/site";
---

<footer>
  <div class="footer-brand">{siteConfig.brand.base}<span>{siteConfig.brand.suffix}</span></div>
  <p>有趣的信息，被认真地整理。</p>
  <div class="footer-links">
    {siteConfig.footerNavigation.map((link) => <a href={link.href}>{link.label}</a>)}
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} {siteConfig.name}</span>
    <span>AI 辅助整理 · 人工确认发布</span>
  </div>
</footer>
