---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleRecommendations from "./ArticleRecommendations.astro";
import ImageRecommendations from "./ImageRecommendations.astro";
import FavoriteButton from "./FavoriteButton.astro";
import { contentHref, selectContentRecommendations } from "../lib/content";
import { staticRecommendationIds } from "../lib/recommendation-manifest";

interface Props {
  item: CollectionEntry<"images">;
}

const { item } = Astro.props;
const canonicalPath = contentHref(item);
const { Content } = await render(item);
const allArticles = (await getCollection("articles")).filter((entry) => !entry.data.draft);
const allImages = (await getCollection("images")).filter((entry) => !entry.data.draft && entry.data.public);
const relatedImages = selectContentRecommendations(item, allImages, {
  limit: 8,
  relatedSlots: 8,
  allowSurprise: false,
  preferredIds: staticRecommendationIds(item.data.contentId, "images"),
});
const relatedArticles = selectContentRecommendations(item, allArticles, {
  limit: 8,
  relatedSlots: 2,
  allowSurprise: false,
  preferredIds: staticRecommendationIds(item.data.contentId, "articles"),
});
const isUserProvided = item.data.sourceKind === "user_provided";
const isUnknownSource = item.data.sourceKind === "unknown";
const imageAspectRatio =
  item.data.width && item.data.height
    ? `${item.data.width} / ${item.data.height}`
    : undefined;
---

<article class="detail-page image-detail" data-detail-content data-detail-kind="image" data-content-id={item.data.contentId}>
  <a class="back-link" href="/images">← 返回图片库</a>
  <div class="image-detail-grid">
    <figure
      class:list={[`ratio-${item.data.ratio}`]}
      style={imageAspectRatio ? `--image-aspect-ratio: ${imageAspectRatio}` : undefined}
    >
      <img
        src={item.data.image}
        alt={item.data.altText || item.data.title}
        width={item.data.width}
        height={item.data.height}
        referrerpolicy="no-referrer"
      />
    </figure>
    <div class="image-detail-copy">
      <p class="section-kicker">REACTION / 图片详情</p>
      <h1>{item.data.title}</h1>
      <p class="detail-summary">{item.data.description}</p>
      <dl>
        <div><dt>分类</dt><dd>{item.data.category}</dd></div>
        <div><dt>情绪</dt><dd>{item.data.mood.join(" / ") || "未分类"}</dd></div>
        <div><dt>场景</dt><dd>{item.data.scenes.join(" / ") || "通用"}</dd></div>
      </dl>
      <div class="card-tags">
        {item.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
      </div>
      <div class="image-detail-actions">
        <FavoriteButton
          contentId={item.data.contentId}
          kind="image"
          title={item.data.title}
          href={canonicalPath}
        />
        <a class="image-original-link" href={item.data.image} target="_blank" rel="noreferrer">查看 / 保存原图 ↗</a>
        <button class="copy-link-button" type="button" data-copy-url={canonicalPath}>复制链接</button>
      </div>
      <p class="image-save-hint">打开原图后，可长按或右键保存。</p>
      <p class="action-feedback" data-copy-status role="status" aria-live="polite"></p>
      <input class="copy-link-fallback" data-copy-fallback aria-label="图片链接，可选择后复制" readonly hidden />
      <div class="prose image-note"><Content /></div>
      <p class="image-source">
        {isUserProvided
          ? "图片来源：用户提供 · 已确认可公开发布"
          : isUnknownSource
            ? <><span>图片来源：群聊转存 · 原作者与授权信息待核实</span> · <a href="/rights">权利人投诉与下架</a></>
            : `图片来源备注：${item.data.source}`}
      </p>
    </div>
  </div>
  <ImageRecommendations images={relatedImages} />
  <ArticleRecommendations articles={relatedArticles} limit={2} title="换个口味，读一篇" />
</article>
