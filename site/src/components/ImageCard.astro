---
import { imageMediaType, mediaFilterValues } from "../lib/image-media.mjs";
import type { CollectionEntry } from "astro:content";
import { contentHref } from "../lib/content";
import { foodStallGallery } from "../config/image-collection";
import DisplayImage from "./DisplayImage.astro";

interface Props {
  headingLevel?: "h2" | "h3";
  item: CollectionEntry<"images">;
  recommendation?: boolean;
  hidden?: boolean;
  priority?: boolean;
  deferred?: boolean;
  layout?: "archive" | "home" | "search";
}

const { item, recommendation = false, hidden = false, priority = false, deferred = false } = Astro.props;
const Heading = Astro.props.headingLevel || "h3";
const imageCount = item.data.contentId === foodStallGallery.cover ? foodStallGallery.members.length : item.data.images?.length || 1;
const title = item.data.contentId === foodStallGallery.cover ? foodStallGallery.title : item.data.title;
const isGallery = imageCount > 1;
const href = contentHref(item);
const mediaType = imageMediaType(item.data);
const containsAnimation = ["animated", "mixed"].includes(mediaType);
const mediaLabel = isGallery ? `图集 · ${imageCount} 张${containsAnimation ? " · 含动图" : ""}` : containsAnimation ? "动图" : "";
const accessibleName = isGallery
  ? `${title}，图集，${imageCount} 张${containsAnimation ? "，含动图" : ""}`
  : containsAnimation ? `${title}，动图` : title;
const { image: src, width, height } = item.data;
const displayProps = {
  src, width, height, priority,
  alt: item.data.images?.[0]?.altText || item.data.altText || item.data.title,
  deferCard: deferred,
  animated: item.data.images?.[0]?.animated ?? item.data.animated,
  layout: Astro.props.layout,
};
---

<a
  class:list={["image-card", item.data.ratio]}
  href={href}
  aria-label={accessibleName}
  data-detail-link
  data-detail-kind="image"
  data-recommendation-id={recommendation ? item.data.contentId : undefined}
  hidden={hidden}
  data-media-types={mediaFilterValues(item.data)}
  data-search-item
  data-catalog-id={item.data.contentId}
  data-search={`${item.data.title} ${item.data.description} ${item.data.source} ${item.data.tags.join(" ")} ${item.data.mood.join(" ")} ${item.data.scenes.join(" ")}`.toLowerCase()}
>
  {recommendation ? (
    <div class="image-recommendation-media" data-image-ratio={width && height ? `${width}x${height}` : undefined}>
      <DisplayImage {...displayProps} layout="recommendation" />
      {mediaLabel && <span class="image-recommendation-kind" aria-hidden="true">{mediaLabel}</span>}
    </div>
  ) : (
    <>
      <DisplayImage {...displayProps} />
      {mediaLabel && <div class="image-copy">
        <span class="image-count">{mediaLabel}</span>
      </div>}
    </>
  )}
  <Heading class="sr-only">{title}</Heading>
</a>
