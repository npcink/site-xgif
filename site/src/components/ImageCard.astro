---
import type { CollectionEntry } from "astro:content";
import { contentHref } from "../lib/content";

interface Props {
  item: CollectionEntry<"images">;
  recommendation?: boolean;
  hidden?: boolean;
}

const { item, recommendation = false, hidden = false } = Astro.props;
const imageCount = item.data.images?.length || 1;
const href = contentHref(item);
---

<a
  class:list={["image-card", item.data.ratio]}
  href={href}
  data-detail-link
  data-detail-kind="image"
  data-recommendation-id={recommendation ? item.data.contentId : undefined}
  hidden={hidden}
  data-search-item
  data-search={`${item.data.title} ${item.data.description} ${item.data.source} ${item.data.tags.join(" ")} ${item.data.mood.join(" ")} ${item.data.scenes.join(" ")}`.toLowerCase()}
  aria-label={`查看图片：${item.data.title}${imageCount > 1 ? `，共 ${imageCount} 张` : ""}`}
>
  <img
    src={item.data.image}
    alt={item.data.altText || item.data.title}
    width={item.data.width}
    height={item.data.height}
    loading="lazy"
    decoding="async"
    referrerpolicy="no-referrer"
  />
  <div class="image-shade"></div>
  <div class="image-copy">
    <div class="image-tags">
      {item.data.tags.slice(0, 2).map((tag) => <span>#{tag}</span>)}
    </div>
    <h3>{item.data.title}</h3>
    <p>{item.data.description}</p>
  </div>
  {imageCount > 1 && <span class="image-count">共 {imageCount} 张</span>}
  <span class="open-mark" aria-hidden="true">↗</span>
</a>
